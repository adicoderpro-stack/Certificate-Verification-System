# ==============================================================================
# CredChain — Frontend Configuration (.env.example)
# Note: In Vite, only variables prefixed with VITE_ are exposed to client code.
# NEVER put private keys or secrets here.
# ==============================================================================

# Smart Contract Addresses (Populate after deploying to Sepolia in Phase 4)
VITE_INSTITUTION_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_DIGITAL_CREDENTIAL_ADDRESS=0x0000000000000000000000000000000000000000

# Public Ethereum Sepolia RPC Endpoint (used for decentralized reads without wallet)
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional: Dedicated Application Backend URL (Leave empty for pure on-chain mode)
VITE_API_URL=

# Optional: Custom Public Verification Root URL (Defaults to window.location.origin)
VITE_VERIFY_URL=
