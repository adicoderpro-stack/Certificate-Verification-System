# ==============================================================================
# CredChain — Member 1 Blockchain Core Environment Configuration (Template)
# Copy this file to .env and configure your values.
# NEVER commit your actual .env file or real private keys to version control.
# ==============================================================================

# --- Local Hardhat Network (Default) ---
# Hardhat Local RPC URL
LOCAL_RPC_URL=http://127.0.0.1:8545

# --- Public Ethereum Testnet (Sepolia) ---
# Public node fallback: https://ethereum-sepolia-rpc.publicnode.com
# Or your custom Alchemy / Infura / QuickNode RPC URL:
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Deployer Private Key for Sepolia (without 0x or with 0x prefix)
# Ensure this account is funded with Sepolia Test ETH from a faucet.
# NEVER USE A MAINNET ACCOUNT OR REAL FUNDS.
SEPOLIA_PRIVATE_KEY=your_sepolia_deployer_private_key_here

# Etherscan API Key for contract verification on Sepolia (optional, from etherscan.io)
ETHERSCAN_API_KEY=your_etherscan_api_key_here
